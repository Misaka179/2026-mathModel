# 大型/临时文件不进仓库——数据、中间产物放各人本地 workspace

# 本地 Agent 配置
.claude/

# Python
__pycache__/
*.pyc
*.egg-info/

# 系统
.DS_Store
Thumbs.db

# 临时文件
*.log
*.tmp
*.bak
*.swp
~$*

# 大型原始数据 / 二进制产物（个人 workspace 自留，不进仓库）
workspace/
*.xlsx
*.csv
*.pkl
*.npz

# 但答案文件和结果文件例外（需要版本控制）
!answer/*.xlsx
!questions/*/05_results/*.xlsx

# 论文编译中间产物（final/ 只放成品）
*.aux
*.log.bak
