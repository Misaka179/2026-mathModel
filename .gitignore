# 大型/临时文件不进仓库——数据、中间产物放各人本地 workspace

# 本地 Agent 配置
.claude/

# Python
__pycache__/
*.pyc
*.egg-info/

# 系统
.DS_Store
Thumbs.db

# 临时文件
*.log
*.tmp
*.bak
*.swp

# 大型原始数据 / 二进制产物（个人 workspace 自留，不进仓库）
workspace/
*.csv
*.pkl
*.npz

